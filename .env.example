# Copy to .env locally. Generate passwords and CSRF_SECRET; no default secrets.
POSTGRES_USER=jobassistant
POSTGRES_DB=jobassistant
POSTGRES_PASSWORD=
DATABASE_URL=
CSRF_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
APP_ENV=development
APP_ORIGIN=http://localhost:8080
HTTP_ADDR=:8080
# Optional: no key means local extraction, manual confirmation and rules only.
PRIVATE_STORAGE_DIR=/app/private
MODEL_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-flash
MODEL_API_KEY=
# Separate encryption key for per-user Feishu settings. Back up separately from the DB.
NOTIFICATION_KEY=
# Simulation mode is the default; only explicitly enable real delivery after binding and testing.
NOTIFICATIONS_SEND_ENABLED=false
AUTOMATION_ENABLED=true
# Optional HTTP proxy reachable from Docker; leave empty for a direct connection.
COLLECTOR_HTTP_PROXY=
COLLECTOR_HTTPS_PROXY=
